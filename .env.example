# Environment Configuration for Azure RAG Chatbot
# Copy this file to .env and fill in your values

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=manuals-index

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Azure Blob Storage
BLOB_CONN_STR=
BLOB_CONTAINER=manuals

# Azure Document Intelligence (OCR)
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# RAG Configuration
TOP_K=6
TEMPERATURE=0
MIN_GROUNDED_SCORE=0.7

# Cosmos DB (for audit/chat history)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=rag-chatbot
COSMOS_CONTAINER=audit-logs

# Audit Configuration
AUDIT_ENABLED=true

# Authentication Configuration
# Mode A (POC): api_key - requires API_KEY to be set
# Mode B (Enterprise): managed_identity - uses Azure Entra ID
AUTH_MODE=api_key
API_KEY=

# Azure Entra ID / Managed Identity (for AUTH_MODE=managed_identity)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
